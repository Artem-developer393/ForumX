Options -Indexes
DirectoryIndex index.php
AddDefaultCharset utf-8

RewriteEngine On

# 1. Block private directories.
RewriteRule ^(?:src|vendor|tests?|docker|database|docs)(?:/|$) - [F,L,NC]

# 2. Block hidden files and directories (.env, .git, .htaccess, etc.).
RewriteRule (^|/)\. - [F,L]

# 3. Block sensitive files and file extensions.
RewriteRule ^(?:credentials\.json|Dockerfile|composer\.(?:json|lock)|compose\.ya?ml|.*\.(?:sql|json|lock|md|py|log|bak|ini|ya?ml))$ - [F,L,NC]

# 4. Serve existing public files and directories.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Route other requests through the PHP entry point.
RewriteRule ^ index.php [L]
# Copy to .env and replace all CHANGE_ME values before running.
APP_PORT=8080
APP_URL=http://localhost:8080
DB_HOST=db
DB_PORT=3306
DB_NAME=webforum
DB_USER=forumx
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ISSUER=forumx-local
# SMTP is required for registration verification and password recovery.
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=forumx@example.invalid
MAIL_FROM_NAME=ForumX
